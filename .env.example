# ChatKazi API Key — from your ChatKazi dashboard
CHATKAZI_API_KEY=ck_live_your_key_here

# Anthropic API Key — from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional: override Claude's personality
SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Keep replies concise and friendly, as if texting. Use plain text only — no markdown.

# Port (Render sets this automatically — don't change)
PORT=3000
